{
    "name": "clip-relay-mobile",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "cap:sync": "npx cap sync",
        "cap:android": "npx cap open android",
        "cap:ios": "npx cap open ios",
        "android:help": "powershell.exe -ExecutionPolicy Bypass -File .\\scripts\\run-gradle.ps1 help --no-daemon",
        "android:assembleDebug": "powershell.exe -ExecutionPolicy Bypass -File .\\scripts\\run-gradle.ps1 assembleDebug --no-daemon"
    },
    "dependencies": {
        "@capacitor/android": "^7.0.0",
        "@capacitor/app": "^7.0.0",
        "@capacitor/camera": "^7.0.0",
        "@capacitor/core": "^7.0.0",
        "@capacitor/filesystem": "^7.0.0",
        "@capacitor/preferences": "^7.0.0",
        "@capacitor/share": "^7.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.0.0",
        "typescript": "^5.8.2",
        "vite": "^6.2.0"
    }
}
